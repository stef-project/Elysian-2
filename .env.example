# Copier en .env.local pour développement local (jamais commité — voir .gitignore).
# En production (Vercel), définir ces variables dans Project Settings > Environment Variables.

# Active la route /use-package (parcours "réserver avec un forfait existant").
# Laisser absent ou "false" tant que Google Workspace (Sheet + Apps Script +
# calendrier dédié) n'est pas configuré et le lancement validé.
VITE_PACKAGE_BOOKING_ENABLED=false

# URL de la Web App Apps Script déployée (package-booking/). Optionnel : une
# URL de repli est déjà codée en dur dans src/lib/packageBooking.ts, cette
# variable permet de la surcharger par environnement (utile pour une rotation
# d'URL sans modifier le code) sans que ce soit obligatoire.
# VITE_PACKAGE_BOOKING_WEBAPP_URL=

# Active la route /offer/:offerId (Phase 2, Étape B — "Proposer un forfait").
# Indépendante de VITE_PACKAGE_BOOKING_ENABLED. Laisser absent ou "false" tant
# que le parcours n'a pas été testé en conditions réelles.
VITE_PACKAGE_OFFER_ENABLED=false

# Active la route /buy-package (achat en ligne d'un forfait publié, Stripe
# Checkout). Indépendante des flags ci-dessus. Laisser absent ou "false" tant
# que la clé Stripe n'est pas configurée (menu Elysian Admin > Portail web)
# et qu'aucun modèle de forfait n'est publié (visibilite=public, statut=actif).
VITE_PACKAGE_PURCHASE_ENABLED=false
