# Copier en .env.local pour développement local (jamais commité — voir .gitignore).
# En production (Vercel), définir ces variables dans Project Settings > Environment Variables.

# Active la route /use-package (parcours "réserver avec un forfait existant").
# Laisser absent ou "false" tant que Google Workspace (Sheet + Apps Script +
# calendrier dédié) n'est pas configuré et le lancement validé.
VITE_PACKAGE_BOOKING_ENABLED=false
